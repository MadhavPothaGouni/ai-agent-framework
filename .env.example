# App
APP_ENV=development
SECRET_KEY=changeme

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/agent_framework
REDIS_URL=redis://localhost:6379/0

# LLM Providers
# LLM_PROVIDER=mock uses a deterministic fake model — no key needed, safe default.
# Set LLM_PROVIDER=anthropic (+ ANTHROPIC_API_KEY, + `pip install anthropic`)
# to have the Coder/Tester agents generate and test real, task-specific code.
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Each workflow run's generated files land in a subfolder here
WORKSPACE_ROOT=./agent_workspace

# Auth
JWT_SECRET=changeme
JWT_EXPIRE_MINUTES=60
